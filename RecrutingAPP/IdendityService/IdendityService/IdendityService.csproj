<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

	<ItemGroup>
		<!-- Latest Swashbuckle -->
		<PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
		<PackageReference Include="NLog.Web.AspNetCore" Version="6.1.1" />
		<PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="7.1.0" />

		<!-- Microsoft Identity -->
		<PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.2.0" />

		<!-- MongoDB Identity (AspNetCore.Identity.MongoDB) -->
		<PackageReference Include="AspNetCore.Identity.MongoDbCore" Version="2.0.7" />

		<!-- JWT Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

		<!-- MongoDB Driver -->
		<PackageReference Include="MongoDB.Driver" Version="2.26.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Shared.Contracts\Shared.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="NLog.config">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
