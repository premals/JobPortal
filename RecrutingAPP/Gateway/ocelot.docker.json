{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/admin/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/identity/admin/{everything}",
      "UpstreamHttpMethod": [ "POST", "GET", "PUT", "DELETE", "PATCH", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/Auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/identity/{everything}",
      "UpstreamHttpMethod": [ "POST", "GET", "PUT", "DELETE", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/Profile/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/profile/{everything}",
      "UpstreamHttpMethod": [ "POST", "GET", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/jobs/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "job-provider-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/jobprovider/jobs/{everything}",
      "UpstreamHttpMethod": [ "POST", "GET", "PUT", "DELETE", "PATCH" ]
    },
    {
      "DownstreamPathTemplate": "/api/jobseeker/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "job-seeker-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/jobseeker/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "PATCH" ]
    }
  ],
  "AuthenticationProviderKey": "Bearer",
  "GlobalConfiguration": {
    "BaseUrl": "http://gateway:8080"
  }
}
